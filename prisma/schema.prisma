generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  department String // management, sales, operations, support, research, sourcing, etc.
  role       String // admin, manager, employee
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Member {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  memberCode String  @unique
  firstName  String
  lastName   String?
  fullName   String
  phone      String
  email      String
  state      String?

  // Membership & Expiration Lifecycle
  programType   String    @default("Platinum") // Platinum, PNP, etc.
  department    String?   @default("operations") // Owning department; legacy records default to Operations
  enrollingDate DateTime?
  endDate       DateTime?
  plan          String?   @default("6 Months") // 6 Months, Yearly, Custom
  activeStatus  String    @default("Active") // Active, Not Active, On Hold, Expired
  holdReason    String?

  // Executive Assignment & Sessions
  allotedTo        String? // Assigned staff member (e.g. Samyak, Mayank, Jaanvi, Muskaan, etc.)
  oneOnOneSessions Int     @default(0) // AB 1 on 1 Session count

  // Business, Sourcing & Brands
  businessType        String? // Reseller, Private label, Both
  brandCollaborations String?
  plBrand             String? // Category / Private Label Brand
  resellingBrand      String? // Reselling Brand
  salesData           String? // e.g. "45000", "2.5 Lakhs", "4 lacs per month"
  salesAmount         Float? // Parsed numeric value for revenue analytics

  // 5-Stage Journey Engine
  currentStage     String  @default("onboarding") // onboarding, research, sourcing, approval, growth
  currentMilestone String? // Decision Stage, Brand/Product Validation, Authorization/Sourcing, Financial Validation, Go-Live Ready/Growth
  healthStatus     String  @default("healthy") // healthy, warning, critical, needs_attention
  paymentStatus    String  @default("paid") // paid, partial, unpaid, unknown
  paymentNotes     String?

  // Additional Dossier & Communication Tracking
  notes             String?
  detailedNotes     String?
  lastConnectDate   DateTime?
  nextConnectDate   DateTime?
  lastContactMedium String?   @default("phone") // phone, whatsapp, zoom, meet, email, sms
  lastContactStaff  String? // Staff member who last contacted

  // Follow-up eligibility: auto follows active/recently-expired members; always/never are Super Admin overrides
  followUpPreference          String?   @default("auto") // auto, always, never
  followUpPreferenceReason    String?
  followUpPreferenceUpdatedAt DateTime?
  followUpPreferenceUpdatedBy String?

  // Registration approval. Existing records without this field are treated as approved.
  approvalStatus        String?   @default("approved") // pending, approved, rejected
  requestedProgram      String?
  requestedProgramOther String?
  submittedByUser       String?   @db.ObjectId
  submittedByName       String?
  submittedByEmail      String?
  submittedByDepartment String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  reviewedByName        String?
  reviewedByEmail       String?
  reviewNotes           String?

  budgetAvailable String?
  gstStatus       String?
  countryInterest String? // USA, Australia, UAE, UK, India

  callLogs              CallLog[]
  queryTransfers        QueryTransfer[]
  serviceReferrals      MemberServiceReferral[]
  followUpTasks         FollowUpTask[]
  departmentUpdates     DepartmentUpdate[]
  oneOnOneSessionRecords OneOnOneSession[]
  aiAnalysis            MemberAiAnalysis?
  externalRegistrations ExternalRegistration[]
  leads                 Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalRegistration {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  source   String
  eventId  String
  memberId String? @db.ObjectId
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  amount       Float
  currency     String    @default("INR")
  programType  String
  paymentLabel String?
  email        String
  phone        String?
  status       String    @default("processing") // processing, processed, failed
  errorMessage String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, eventId])
  @@index([memberId, receivedAt])
  @@index([status, updatedAt])
}

model LeadSource {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  slug        String  @unique
  sourceType  String  @default("api") // wati, manual, api, form, ads, other
  description String?
  active      Boolean @default(true)

  webhookEnabled    Boolean @default(false)
  webhookSecretHash String?
  webhookSecretHint String?
  defaultCampaign   String?
  defaultDepartment String? @default("sales")

  createdByUser  String? @db.ObjectId
  createdByName  String?
  createdByEmail String?

  leads         Lead[]
  importBatches LeadImportBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, name])
}

model LeadImportBatch {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  sourceId String     @db.ObjectId
  source   LeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  fileName    String
  status      String  @default("processing") // processing, completed, failed
  totalRows   Int     @default(0)
  imported    Int     @default(0)
  skipped     Int     @default(0)
  failed      Int     @default(0)
  mappingJson String?
  errorText   String?

  createdByUser  String? @db.ObjectId
  createdByName  String
  createdByEmail String

  leads Lead[]

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model Lead {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  sourceId      String           @db.ObjectId
  source        LeadSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  importBatchId String?          @db.ObjectId
  importBatch   LeadImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  memberId      String?          @db.ObjectId
  member        Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)

  externalId String
  dedupeKey  String

  fullName  String
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  company   String?
  location  String?

  responseCode String  @default("other") // already_paid, will_pay_shortly, has_question, other
  responseText String?
  campaign     String?
  status       String  @default("new") // new, contacted, qualified, converted, closed
  priority     String  @default("medium") // low, medium, high, urgent
  notes        String?

  assignedToUser       String? @db.ObjectId
  assignedToName       String?
  assignedToEmail      String?
  assignedToDepartment String?

  rawPayloadJson String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId, status, receivedAt])
  @@index([responseCode, receivedAt])
  @@index([phone])
  @@index([email])
  @@index([memberId])
  @@index([dedupeKey])
}

model MemberAiAnalysis {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @unique @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // The factual CRM history is the source of truth. This record is a cached,
  // replaceable analysis of that history and is never used to overwrite it.
  status            String    @default("processing") // processing, ready, failed
  executiveBrief    String?
  currentStatus     String?
  escalationLevel   String?
  escalationSummary String?
  analysisJson      String?
  sourceHash        String
  sourceEventCount  Int       @default(0)
  provider          String?
  model             String?
  lastError         String?
  refreshStartedAt  DateTime?
  generatedAt       DateTime?
  generatedByName   String?
  generatedByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

model DepartmentUpdate {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  department String
  category   String?
  status     String  @default("in_progress") // not_started, in_progress, waiting, completed, blocked
  summary    String
  details    String?
  nextStep   String?

  updatedByUser  String? @db.ObjectId
  updatedByName  String
  updatedByEmail String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, department, createdAt])
  @@index([department, status, updatedAt])
}

model CallLog {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  date     DateTime @default(now())
  type     String   @default("outbound") // inbound, outbound
  medium   String   @default("phone") // phone, whatsapp, zoom, meet, email, sms, in_person
  outcome  String // Connected, Scheduled 1-on-1, Voicemail, Busy, No Answer, Resolved, Followup Required
  duration Int?     @default(0) // duration in minutes
  notes    String

  staffName       String?
  staffEmail      String?
  staffDepartment String?
  staffUserId     String? @db.ObjectId

  editedAt      DateTime?
  editedByName  String?
  editedByEmail String?

  // External automation provenance. A Zoom-generated communication remains
  // linked to the verified 1-on-1 session that created it.
  source             String? @default("manual") // manual, zoom_automation, webhook, import
  externalReference  String?
  oneOnOneSessionId  String? @db.ObjectId

  createdAt DateTime @default(now())

  @@index([oneOnOneSessionId])
  @@index([source, date])
}

model OneOnOneSession {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  sessionNumber Int
  sequence      Int    @default(1)
  status        String @default("scheduling") // scheduling, scheduled, started, processing, completed, review_required, cancelled, failed

  scheduledStart  DateTime
  timezone        String @default("Asia/Calcutta")
  plannedDuration Int    @default(60)
  actualStart     DateTime?
  actualEnd       DateTime?
  verifiedMinutes Int?

  attendanceStatus     String  @default("pending") // pending, processing, verified, review_required, unavailable
  attendanceMatchMethod String?
  attendanceJson        String?

  memberQuestions  String?
  preparationNotes String?
  postMeetingNotes String?

  coordinatorUserId     String? @db.ObjectId
  coordinatorName       String
  coordinatorEmail      String
  coordinatorDepartment String

  zoomMeetingId     String?
  zoomMeetingUuid   String?
  zoomHostUserId    String
  zoomHostName      String?
  zoomHostEmail     String?
  joinUrl           String?

  transcriptStatus String  @default("pending") // pending, processing, ready, unavailable, failed
  transcriptText   String?
  transcriptHash   String?
  recordingJson    String?

  aiStatus      String  @default("pending") // pending, processing, ready, review_required, failed, skipped
  aiSummary     String?
  aiAnalysisJson String?
  aiSourceHash  String?
  aiProvider    String?
  aiModel       String?

  callLogId     String? @db.ObjectId
  lastError     String?
  processingAttempts Int @default(0)
  lastProcessedAt DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancellationReason String?
  rescheduleHistoryJson String?

  createdByUser  String? @db.ObjectId
  createdByName  String
  createdByEmail String

  attendanceSegments OneOnOneAttendanceSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, sessionNumber, sequence])
  @@index([memberId, status, scheduledStart])
  @@index([zoomMeetingId])
  @@index([zoomMeetingUuid])
  @@index([status, scheduledStart])
  @@index([transcriptStatus, updatedAt])
}

model OneOnOneAttendanceSegment {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String          @db.ObjectId
  session   OneOnOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  participantKey   String
  participantId    String?
  participantUserId String?
  participantName  String
  participantEmail String?
  participantRole  String @default("other") // host, member, other
  joinAt            DateTime
  leaveAt           DateTime
  durationSeconds   Int
  rawJson            String?

  createdAt DateTime @default(now())

  @@index([sessionId, participantRole, joinAt])
  @@index([participantEmail])
}

model ZoomWebhookEvent {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  eventKey String @unique

  eventType      String
  eventTimestamp DateTime?
  zoomMeetingId  String?
  zoomMeetingUuid String?
  sessionId      String? @db.ObjectId
  payloadJson    String
  status         String  @default("received") // received, processing, processed, ignored, failed
  attempts       Int     @default(0)
  lastError      String?
  processedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([zoomMeetingId, createdAt])
  @@index([sessionId, createdAt])
}

model QueryTransfer {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fromDepartment  String
  toDepartment    String
  assignedToUser  String? @db.ObjectId
  assignedToName  String?
  assignedToEmail String?
  priority        String  @default("medium") // low, medium, high, urgent

  reason           String
  status           String    @default("pending") // pending, resolved
  resolutionNotes  String?
  resolutionMedium String?
  resolvedByName   String?
  resolvedByEmail  String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
}

model FollowUpTask {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title        String   @default("Member follow-up")
  instructions String?
  priority     String   @default("medium") // low, medium, high, urgent
  status       String   @default("pending") // pending, in_progress, completed, cancelled
  dueAt        DateTime

  sourceType       String? @default("manual") // manual, communication, transfer
  assignmentType   String? @default("self") // self, transferred
  sourceCallLogId  String? @db.ObjectId
  sourceTransferId String? @db.ObjectId

  assignedToUser       String @db.ObjectId
  assignedToName       String
  assignedToEmail      String
  assignedToDepartment String

  createdByUser       String @db.ObjectId
  createdByName       String
  createdByEmail      String
  createdByDepartment String

  completedAt     DateTime?
  completedByUser String?   @db.ObjectId
  completedByName String?
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToUser, status, dueAt])
  @@index([assignedToDepartment, status, dueAt])
  @@index([assignmentType, status, dueAt])
  @@index([sourceTransferId])
  @@index([memberId, status])
}

model Program {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  codePrefix  String   @unique
  description String?
  icon        String?  @default("👑")
  color       String?  @default("#f59e0b")
  badgeColor  String?  @default("amber")
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServicePartner {
  id                    String  @id @default(auto()) @map("_id") @db.ObjectId
  serviceCode           String  @unique
  serviceName           String
  providerName          String
  category              String
  description           String?
  benefitLabel          String?
  includedConsultations Int     @default(0)
  contactPerson         String?
  contactEmail          String?
  contactPhone          String?
  active                Boolean @default(true)
  order                 Int     @default(0)

  referrals MemberServiceReferral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MemberServiceReferral {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  memberId  String         @db.ObjectId
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  partnerId String         @db.ObjectId
  partner   ServicePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  status          String    @default("referred") // referred, contacted, consultation_scheduled, in_progress, completed, on_hold, cancelled
  ownerName       String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  notes           String?
  assignedByName  String?
  assignedByEmail String?
  updatedByName   String?
  updatedByEmail  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, partnerId])
  @@index([status])
}
